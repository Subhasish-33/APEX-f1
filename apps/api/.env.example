# ==============================================================================
# APEX-F1 Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database
# Use the "Transaction Pooler" string (port 6543) for async SQLAlchemy.
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Get this from: Upstash Console → Redis Database → REST API → .env
# Format: rediss://default:[token]@[endpoint]:6379
REDIS_URL=rediss://default:[TOKEN]@[ENDPOINT].upstash.io:6379

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | production
ENVIRONMENT=development

# ── (Optional) Local Fallbacks ────────────────────────────────────────────────
# Use these ONLY if running a local Postgres/Redis for testing.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/apex_f1
# REDIS_URL=redis://localhost:6379/0
